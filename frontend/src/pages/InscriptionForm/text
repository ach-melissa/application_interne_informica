import { useState } from 'react';
import logo from '../../assets/images/logo_informica.png';

const NIVEAU_OPTIONS = ['Primaire', 'Moyen', 'Secondaire', 'Bac', 'Licence', 'Master', 'Doctorat', 'Autre'];
const FORMATION_OPTIONS = ['Informatique', 'Bureautique', 'Comptabilité', 'Anglais', 'Arabe', 'Autre'];
const DUREE_OPTIONS = ['1 mois', '2 mois', '3 mois', '6 mois', '1 an'];
const GROUPE_OPTIONS = ['G1', 'G2', 'G3', 'G4'];
const SOURCE_OPTIONS = ['Amis/Famille', 'Instagram', 'TikTok', 'Facebook', 'Recherche Google', 'Site Web', 'Bouche-à-oreille', 'Publicité', 'Autre'];

const printFields = [
  { fr: 'Nom',                  ar: 'اللقب' },
  { fr: 'Prénom',               ar: 'الاسم' },
  { fr: 'Date de naissance',    ar: 'تاريخ الميلاد' },
  { fr: 'Lieu de naissance',    ar: 'مكان الميلاد' },
  { fr: 'Adresse Personnelle',  ar: 'العنوان الشخصي' },
  { fr: '',                     ar: '' }, // second line for adresse
  { fr: 'Niveau Scolaire',      ar: 'المستوى التعليمي' },
  { fr: 'Adresse électronique', ar: 'البريد الإلكتروني' },
  { fr: 'Numéro de téléphone',  ar: 'رقم الهاتف' },
  { fr: 'Formation choisie',    ar: 'التكوين المختار' },
  { fr: 'Durée de formation',   ar: 'مدة التكوين' },
  { fr: 'Groupe',               ar: 'الفوج' },
];

export default function InscriptionForm() {
  const [form, setForm] = useState({
    nom: '', prenom: '', ddn: '', lieu: '',
    adresse1: '', adresse2: '', niveau: '',
    email: '', tel: '', formation: '',
    duree: '', groupe: '', source: '',
  });
  const [submitted, setSubmitted] = useState(false);

  const set = (k, v) => setForm(f => ({ ...f, [k]: v }));

  const inputCls = "w-full border border-[#E2E8F0] rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB] bg-white";
  const selectCls = "w-full border border-[#E2E8F0] rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB] bg-white text-[#1E293B]";
  const labelCls = "block text-xs font-semibold text-[#64748B] mb-1";

  const Header = () => (
    <>
      <div className="flex items-start justify-between border-b-2 border-black pb-4 mb-4">
        <img src={logo} alt="INFORMICA" className="h-24 w-auto object-contain" />
        <div className="text-right text-[10px] text-gray-500 leading-[1.7]">
          <p>Cité Amiguela, Groupement Rés. N°1234, N°34 – 2ème – Blida – Boumérdès</p>
          <p>Tél./Fax : 034 70 07 47 / GSM : 0661 675 954</p>
          <p>Email : informica@gmail.com | Site : informica.com</p>
          <p>RC : 3RS071762-00/A16</p>
        </div>
      </div>
      <div className="text-center mb-5">
        <p className="text-lg tracking-widest text-gray-500 uppercase">ECOLE DE FORMATION</p>
        <h1 className="text-4xl font-black tracking-widest text-black leading-tight">INFORMICA</h1>
      </div>
    </>
  );

  return (
    <div className="min-h-screen bg-gray-100 py-10 px-4">

      {/* ══════════════ PRINT VERSION ══════════════ */}
      <div className="bg-white w-full max-w-3xl mx-auto p-10 shadow-md mb-10 print:shadow-none">
        <Header />
        <div className="space-y-5">
          {printFields.map((f, i) => (
            <div key={i} className="flex items-end gap-2">
              <span className="text-sm font-semibold text-black whitespace-nowrap w-44 shrink-0">{f.fr}{f.fr ? ' :' : ''}</span>
              <div className="flex-1 border-b border-dotted border-black h-4" />
              <span className="text-sm font-semibold text-black whitespace-nowrap w-36 shrink-0 text-right" style={{ fontFamily: 'serif', direction: 'rtl' }}>
                {f.ar ? `: ${f.ar}` : ''}
              </span>
            </div>
          ))}
        </div>
        <div className="border-t border-dotted border-black mt-8 mb-6" />
        <div className="flex justify-between items-start text-sm">
          <div>
            <p className="text-sm font-semibold text-black mb-2" style={{ fontFamily: 'serif', direction: 'rtl' }}>إمضاء المعني</p>
            <div className="border border-gray-300 w-48 h-16 rounded" />
          </div>
          <span className="font-semibold" dir="rtl">
            التاريخ: <span className="inline-block border-b border-dotted border-black w-32 mr-1" />
          </span>
        </div>
      </div>

      {/* ══════════════ DIGITAL FORM ══════════════ */}
      <div className="bg-white w-full max-w-3xl mx-auto p-10 shadow-md print:hidden">
        <Header />
        <p className="text-xs text-[#94A3B8] mb-6 text-center tracking-wide uppercase">Formulaire en ligne — remplissez et soumettez</p>

        {submitted ? (
          <div className="text-center py-10">
            <div className="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
              <svg className="w-7 h-7 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
            </div>
            <h2 className="text-lg font-bold text-[#1E293B] mb-1">Inscription envoyée !</h2>
            <p className="text-sm text-[#64748B]">Nous vous contacterons bientôt.</p>
            <button onClick={() => { setSubmitted(false); setForm({ nom:'',prenom:'',ddn:'',lieu:'',adresse1:'',adresse2:'',niveau:'',email:'',tel:'',formation:'',duree:'',groupe:'',source:'' }); }}
              className="mt-6 text-sm text-[#2563EB] underline">Nouvelle inscription</button>
          </div>
        ) : (
            <form
  className="space-y-4"
  onSubmit={(e) => {
    e.preventDefault();
    setSubmitted(true);
  }}
>
            {/* Row 1 */}
            <div className="grid grid-cols-2 gap-4">
              <div><label className={labelCls}>Nom / اللقب</label><input className={inputCls} value={form.nom} onChange={e => set('nom', e.target.value)} placeholder="Nom" required/></div>
              <div><label className={labelCls}>Prénom / الاسم</label><input className={inputCls} value={form.prenom} onChange={e => set('prenom', e.target.value)} placeholder="Prénom" required /></div>
            </div>
            {/* Row 2 */}
            <div className="grid grid-cols-2 gap-4">
              <div><label className={labelCls}>Date de naissance / تاريخ الميلاد</label><input type="date" className={inputCls} value={form.ddn} onChange={e => set('ddn', e.target.value)} required/></div>
              <div><label className={labelCls}>Lieu de naissance / مكان الميلاد</label><input className={inputCls} value={form.lieu} onChange={e => set('lieu', e.target.value)} placeholder="Lieu" required /></div>
            </div>
            {/* Adresse 2 lines */}
            <div><label className={labelCls}>Adresse Personnelle / العنوان الشخصي</label>
              <input className={inputCls} value={form.adresse1} onChange={e => set('adresse1', e.target.value)} placeholder="Ligne 1" required />
             </div>
            {/* Row 3 */}
            <div className="grid grid-cols-2 gap-4">
              <div><label className={labelCls}>Niveau Scolaire / المستوى التعليمي</label>
                <select className={selectCls} value={form.niveau} onChange={e => set('niveau', e.target.value)}>
                  <option value="">-- Choisir --</option>
                  {NIVEAU_OPTIONS.map(o => <option key={o} value={o}>{o}</option>)}
                </select>
              </div>
              <div><label className={labelCls}>Numéro de téléphone / رقم الهاتف</label><input className={inputCls} value={form.tel} onChange={e => set('tel', e.target.value)} placeholder="0X XX XX XX XX" required/></div>
            </div>
            {/* Email */}
            <div><label className={labelCls}>Adresse électronique / البريد الإلكتروني</label><input type="email" className={inputCls} value={form.email} onChange={e => set('email', e.target.value)} placeholder="email@exemple.com" required /></div>
            {/* Row 4 */}
            <div className="grid grid-cols-3 gap-4">
              <div><label className={labelCls}>Formation choisie / التكوين</label>
                <select className={selectCls} value={form.formation} onChange={e => set('formation', e.target.value)}>
                  <option value="">-- Choisir --</option>
                  {FORMATION_OPTIONS.map(o => <option key={o} value={o}>{o}</option>)}
                </select>
              </div>
              <div><label className={labelCls}>Durée / مدة التكوين</label>
                <select className={selectCls} value={form.duree} onChange={e => set('duree', e.target.value)}>
                  <option value="">-- Choisir --</option>
                  {DUREE_OPTIONS.map(o => <option key={o} value={o}>{o}</option>)}
                </select>
              </div>
              <div><label className={labelCls}>Groupe / الفوج</label>
                <select className={selectCls} value={form.groupe} onChange={e => set('groupe', e.target.value)}>
                  <option value="">-- Choisir --</option>
                  {GROUPE_OPTIONS.map(o => <option key={o} value={o}>{o}</option>)}
                </select>
              </div>
            </div>
            {/* Source */}
            <div><label className={labelCls}>Comment vous avez entendu parler de nous ?</label>
              <select className={selectCls} value={form.source} onChange={e => set('source', e.target.value)} required>
                <option value="">-- Choisir --</option>
                {SOURCE_OPTIONS.map(o => <option key={o} value={o}>{o}</option>)}
              </select>
            </div>

            <button
              onClick={() => setSubmitted(true)}
              className="w-full bg-[#1E293B] text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-[#0f172a] transition mt-2"
            >
              Soumettre l'inscription
            </button> 
         </form>
        )}
      </div>
    </div>
  );
}