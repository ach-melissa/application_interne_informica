generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attendance {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id  String            @db.Uuid
  etudiant_id String            @db.Uuid
  statut      attendance_status
  created_at  DateTime?         @default(now()) @db.Timestamp(6)
  etudiants   etudiants         @relation(fields: [etudiant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions    sessions          @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, etudiant_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model etudiants {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom             String                @db.VarChar
  prenom          String                @db.VarChar
  date_naissance  DateTime?             @db.Date
  lieu_naissance  String?               @db.VarChar
  adresse         String?               @db.VarChar
  niveau_scolaire niveau_scolaire_enum?
  email           String?               @db.VarChar
  telephone       String?               @db.VarChar
  created_at      DateTime?             @default(now()) @db.Timestamp(6)
  archived        Boolean?              @default(false)
  photo           String?
  piece_identite  String?
  genre           String?               @default("homme")
  wilaya          wilaya_enum?
  attendance      attendance[]
  inscriptions    inscriptions[]
  payments        payments[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model formations {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                       String                      @db.VarChar(255)
  prix                      Decimal                     @db.Decimal(10, 2)
  heures                    Int
  teacher_id                String?                     @db.Uuid
  statut                    formation_status?           @default(active)
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  prix_etudiant             Decimal?                    @db.Decimal
  tarif_mensuel             Decimal?                    @db.Decimal
  description               String?
  categorie                 String?                     @db.VarChar
  capacite_groupe           Int?                        @default(20)
  attestations              attestations[]
  formation_payment_periods formation_payment_periods[]
  teachers                  teachers?                   @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)
  groups                    groups[]
  inscriptions              inscriptions[]
  payments                  payments[]
  teacher_formations        teacher_formations[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model groups {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id            String?                 @db.Uuid
  formation_id          String                  @db.Uuid
  nom                   String                  @db.VarChar(255)
  statut                group_status?           @default(active)
  archived              Boolean?                @default(false)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  jours_formation       String?
  heure_formation       String?
  annee_scolaire        String?
  date_debut            DateTime?               @db.Date
  date_fin              DateTime?               @db.Date
  en_promotion          Boolean?                @default(false)
  prix_promotion        Decimal?                @db.Decimal
  use_default_periods   Boolean                 @default(true)
  attestations          attestations[]
  group_payment_alerts  group_payment_alerts?
  group_payment_periods group_payment_periods[]
  formations            formations              @relation(fields: [formation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teachers              teachers?               @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)
  inscriptions          inscriptions[]
  schedules             schedules[]
  sessions              sessions[]

  @@index([date_fin], map: "idx_groups_date_fin")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inscriptions {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  etudiant_id          String                @db.Uuid
  formation_id         String                @db.Uuid
  date_inscription     DateTime?             @default(dbgenerated("CURRENT_DATE")) @db.Date
  first_try            try_status?
  second_try           try_status?
  third_try            try_status?
  registered_by        registered_by_enum?
  source               source_enum?
  statut               inscription_status?   @default(pending)
  created_at           DateTime?             @default(now()) @db.Timestamp(6)
  group_id             String?               @db.Uuid
  archived             Boolean?              @default(false)
  annee_scolaire       String?
  attestation_imprimee Boolean?              @default(false)
  added_by             String?
  statut_scolarite     statut_scolarite_enum @default(en_cours)
  en_promotion         Boolean?              @default(false)
  prix_promotion       Decimal?              @db.Decimal
  attestations         attestations[]
  etudiants            etudiants             @relation(fields: [etudiant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  formations           formations            @relation(fields: [formation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groups               groups?               @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id                                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                                     String      @db.VarChar(50)
  statut                                   String      @default("en_attente") @db.VarChar(20)
  lu                                       Boolean     @default(false)
  expediteur_id                            String?     @db.Uuid
  destinataire_role                        String?     @default("admin") @db.VarChar(20)
  titre                                    String?     @db.VarChar(150)
  message                                  String?
  data                                     Json?
  reponse_message                          String?
  traite_par                               String?     @db.Uuid
  traite_le                                DateTime?   @db.Timestamptz(6)
  created_at                               DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime    @default(now()) @db.Timestamptz(6)
  replies                                  Json        @default("[]")
  lu_admin                                 Boolean     @default(true)
  users_notifications_expediteur_idTousers users?      @relation("notifications_expediteur_idTousers", fields: [expediteur_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_notifications_traite_parTousers    users?      @relation("notifications_traite_parTousers", fields: [traite_par], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedules                                schedules[]

  @@index([destinataire_role, statut], map: "idx_notifications_destinataire")
  @@index([expediteur_id], map: "idx_notifications_expediteur")
  @@index([type], map: "idx_notifications_type")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  etudiant_id   String          @db.Uuid
  formation_id  String          @db.Uuid
  montant       Decimal         @db.Decimal(10, 2)
  date_paiement DateTime?       @default(dbgenerated("CURRENT_DATE")) @db.Date
  tranche       Int?            @default(1)
  statut        payment_status? @default(en_attente)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  bon_photo     String?
  etudiants     etudiants       @relation(fields: [etudiant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formations    formations      @relation(fields: [formation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model salaires {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String          @db.Uuid
  montant    Decimal         @db.Decimal(10, 2)
  mois       Int
  annee      Int
  statut     salaire_statut? @default(en_attente)
  note       String?         @db.VarChar(255)
  created_at DateTime?       @default(now()) @db.Timestamp(6)
  users      users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model schedules {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id          String         @db.Uuid
  jour_semaine      day_enum
  heure_debut       DateTime       @db.Time(6)
  heure_fin         DateTime       @db.Time(6)
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  salle             String         @default("Salle 01")
  periode           String         @default("matin")
  contenu           String?
  prof_id           String?        @db.Uuid
  salle_id          String?        @db.Uuid
  applicable_depuis DateTime?      @db.Date
  type_special      String?        @db.VarChar(20)
  expire_le         DateTime?      @db.Date
  notification_id   String?        @db.Uuid
  groups            groups         @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notifications     notifications? @relation(fields: [notification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?         @relation(fields: [prof_id], references: [id], onUpdate: NoAction)
  salles            salles?        @relation(fields: [salle_id], references: [id], onUpdate: NoAction)

  @@index([notification_id], map: "idx_schedules_notification")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sessions {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String          @db.Uuid
  date        DateTime        @db.Date
  statut      session_status? @default(planifiee)
  created_at  DateTime?       @default(now()) @db.Timestamp(6)
  prof_id     String?         @db.Uuid
  duree       String?
  type_seance String          @default("normale")
  salle_id    String?         @db.Uuid
  salle       String?         @db.VarChar
  heure_debut DateTime?       @db.Time(6)
  heure_fin   DateTime?       @db.Time(6)
  attendance  attendance[]
  groups      groups          @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?          @relation(fields: [prof_id], references: [id], onUpdate: NoAction)
  salles      salles?         @relation(fields: [salle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([salle_id, date], map: "idx_sessions_salle_date")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model teachers {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String               @db.Uuid
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  formations         formations[]
  groups             groups[]
  teacher_formations teacher_formations[]
  users              users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                                               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                                              String          @db.VarChar(100)
  prenom                                           String          @db.VarChar(100)
  email                                            String          @unique @db.VarChar(255)
  nom_utilisateur                                  String          @unique @db.VarChar(100)
  mot_de_passe                                     String          @db.VarChar(255)
  telephone                                        String?         @db.VarChar(20)
  date_naissance                                   DateTime?       @db.Date
  role                                             user_role
  created_at                                       DateTime?       @default(now()) @db.Timestamp(6)
  archived                                         Boolean?        @default(false)
  photo_path                                       String?
  notifications_notifications_expediteur_idTousers notifications[] @relation("notifications_expediteur_idTousers")
  notifications_notifications_traite_parTousers    notifications[] @relation("notifications_traite_parTousers")
  salaires                                         salaires[]
  schedules                                        schedules[]
  sessions                                         sessions[]
  teachers                                         teachers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attestations {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inscription_id String?       @db.Uuid
  formation_id   String?       @db.Uuid
  group_id       String?       @db.Uuid
  numero_ref     String        @unique
  date_emission  DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  formations     formations?   @relation(fields: [formation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups         groups?       @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inscriptions   inscriptions? @relation(fields: [inscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model salles {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom        String      @unique
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  schedules  schedules[]
  sessions   sessions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model teacher_formations {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id   String     @db.Uuid
  formation_id String     @db.Uuid
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  formations   formations @relation(fields: [formation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teachers     teachers   @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, formation_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model formation_payment_periods {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formation_id String     @db.Uuid
  numero       Int
  jours_offset Int
  montant      Decimal    @db.Decimal
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  formations   formations @relation(fields: [formation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([formation_id], map: "idx_formation_payment_periods_formation")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model group_payment_periods {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id     String    @db.Uuid
  numero       Int
  due_date     DateTime  @db.Date
  montant      Decimal   @db.Decimal
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  jours_offset Int
  groups       groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([group_id], map: "idx_group_payment_periods_group")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model group_payment_alerts {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id     String    @unique @db.Uuid
  send_count   Int       @default(0)
  last_sent_at DateTime? @db.Date
  active       Boolean   @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  groups       groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum attendance_status {
  present
  absent
  retard
}

enum day_enum {
  lundi
  mardi
  mercredi
  jeudi
  vendredi
  samedi
  dimanche
}

enum formation_status {
  active
  non_active
}

enum group_status {
  active
  inactive
}

enum inscription_status {
  pending
  confirmed
  rejected
  non_confirmed
}

enum payment_status {
  paye
  en_attente
  annule
}

enum registered_by_enum {
  hanane
  yasmine
  page_facebook
  amira
}

enum salaire_statut {
  pay_       @map("payé")
  en_attente
  partiel
}

enum session_status {
  planifiee
  effectuee
  annulee
}

enum source_enum {
  Amis_Famille     @map("Amis/Famille")
  Instagram
  TikTok
  Facebook
  Recherche_Google @map("Recherche Google")
  Site_Web         @map("Site Web")
  Bouche___oreille @map("Bouche-à-oreille")
  Publicit_        @map("Publicité")
  Autre
}

enum try_status {
  repondu
  non_repondu
  occupe
  injoignable
  P_bureau
  ferme
}

enum user_role {
  prof
  admin
  comptable
  super_admin
}

enum niveau_scolaire_enum {
  Primaire
  Moyen
  Secondaire
  Bac
  Licence
  Master
  Doctorat
  Autre
}

